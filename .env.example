# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Configuration - Using MongoDB Atlas for production
# MONGODB_URI=mongodb://localhost:27017/akashraikwar
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Brevo Transactional Email API
# Get API key from https://app.brevo.com/settings/keys
BREVO_API_KEY=your_brevo_api_key_here

# Sender Identity (visible to recipients)
EMAIL_FROM=info@yourdomain.com
EMAIL_FROM_NAME=Your Name

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_here
# Separate secret for refresh tokens (falls back to JWT_SECRET + ':refresh' if unset)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
# Access token lifetime (short-lived). Refresh tokens default to 7 days.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Admin Credentials
ADMIN_USERNAME=admin@yourdomain.com
# Plaintext password: used only to seed the initial DB admin (hashed on save)
ADMIN_PASSWORD=your_secure_password_here
# bcrypt hash: used for env-fallback login when no DB admin exists
# Generate with: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# CORS Configuration - Production frontend
# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=https://yourdomain.com

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite